CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# إعدادات Amazon Product Advertising API 5.0 (للخادم فقط — لا تضعها في المتصفح أبداً)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
